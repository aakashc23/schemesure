# ======================================================================
# SchemeSure configuration — copy to .env and fill in the blanks.
# NEVER commit the real .env file. It is listed in .gitignore.
# ======================================================================

# ---- LLM (Groq, via the OpenAI-compatible endpoint) ----
# Get a free key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=5

# ---- Hugging Face (deployment) ----
# Needs a "write" token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_SPACE_ID=
HF_SPACE_SDK=docker

# ---- Embeddings (free, runs locally, no API key needed) ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# ---- Vector store ----
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=schemesure_schemes

# ---- Retrieval ----
RETRIEVAL_TOP_K=5
# Cosine-similarity floor. Below this, we refuse instead of answering.
# Calibrated against real measured scores -- see docs/DECISIONS.md.
RETRIEVAL_MIN_SCORE=0.45

# ---- Guardrail ----
GUARDRAIL_ENABLED=true
# Fraction of unsupported claims above which we BLOCK the whole answer.
GUARDRAIL_BLOCK_THRESHOLD=0.5

# ---- Monitoring ----
LLM_LOG_DB=./llm_calls.db

# ---- API / UI wiring ----
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
MAX_QUESTION_LENGTH=500
CORS_ALLOW_ORIGINS=*
